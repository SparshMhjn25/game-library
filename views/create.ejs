<!DOCTYPE html>
<html lang="en">
<head>
    <title>Create Genre Form</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <h1>Create your own Genre of Games:</h1>
    <form action="/create" method="post">
        <label for="genreName">Name:</label>
        <input type="text" name="name" id="genreName" required>

        <label for="genreDesc">Description:</label>
        <input type="text" name="description" id="genreDesc">

        <button type="submit">Submit</button>
    </form>
</body>
</html>