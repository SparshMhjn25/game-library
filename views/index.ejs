<!DOCTYPE html>
<html lang="en">
<head>
    <title>Game Library</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <% for(let genre of result){ %>
        <a href="/genres/<%= genre.id %>">
            <div class="genre-card">
                <%= genre.name  %>
                <%= genre.description %>
            </div>
        </a>
    <% } %> 
    <a href="/create" class="create-btn">Create Genre</a>
</body>
</html>