<!DOCTYPE html>
<html lang="en">
<head>
    <title>Create Genre Form</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <h1>Edit Genre of Games:</h1>
    <form action="/genres/<%= result.id %>/edit" method="post">
        <label for="genreName">Name:</label>
        <input type="text" name="name" id="genreName" value="<%= result.name %>" required>

        <label for="genreDesc">Description:</label>
        <input type="text" name="description" id="genreDesc" value="<%= result.description %>" >

        <button type="submit">Submit</button>
    </form>
</body>
</html>