<!DOCTYPE html>
<html lang="en">
<head>
    <title>Edit Game Form</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <h1>Edit Game:</h1>
    <form action="/games/<%= result.id %>/edit" method="post">
        <label for="gameName">Name:</label>
        <input type="text" name="name" id="gameName" value="<%= result.name %>" required>

        <label for="gameDesc">Description:</label>
        <input type="text" name="description" id="gameDesc" value="<%= result.description %>" >
        
        <label for="gameDeveloper">Developer:</label>
        <input type="text" name="developer" id="gameDeveloper" value="<%= result.developer %>" >
        
        <label for="gamePlatform">Platform:</label>
        <input type="text" name="platform" id="gamePlatform" value="<%= result.platform %>" >
        
        <label for="gameGenre">Genre:</label>
        <select name="genre_id" id="gameGenre" required>
            <% for (let genre of genres) { %>
                <option 
                    value="<%= genre.id %>"
                    <%= genre.id === result.genre_id ? 'selected' : '' %>
                >
                    <%= genre.name %>
                </option>
            <% } %>
        </select>

        <button type="submit">Submit</button>
    </form>
</body>
</html>